# Docker 部署环境变量配置模板
# 复制此文件为 .env.docker.local 并填入实际配置

# LLM API 配置
VITE_LLM_API_URL=https://api.openai.com/v1
VITE_LLM_API_KEY=your-llm-api-key
VITE_LLM_MODEL=gpt-3.5-turbo

# Supabase 配置
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 使用说明：
# 1. 复制此文件：cp .env.docker .env.docker.local
# 2. 编辑 .env.docker.local 并填入实际的 API 密钥和配置
# 3. 使用 docker-compose --env-file .env.docker.local up -d 启动